---
// Features are loaded dynamically at runtime from votes.json (data-votes branch).
// Any Discussion in the "Feature Requests" category appears automatically — no code changes needed.
---

<div class="voting-section">
  <p class="voting-subtitle">
    Help us prioritize what to build next. Click any feature to open its GitHub Discussion and leave a 👍 to cast your vote.
  </p>

  <div class="voting-grid" id="voting-grid">
    <p class="voting-loading" id="voting-loading">Loading features…</p>
  </div>

  <p class="voting-note">Vote counts sync hourly from GitHub Discussions.</p>
</div>

<script>
const VOTES_URL = 'https://raw.githubusercontent.com/BugTraceAI/BugTraceAI/data-votes/votes.json';

function escapeHtml(s) {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

async function loadVotes() {
  const grid = document.getElementById('voting-grid');

  try {
    const res = await fetch(VOTES_URL + '?t=' + Date.now());
    if (!res.ok) {
      grid.innerHTML = '<p class="voting-loading">No features yet — check back soon.</p>';
      return;
    }

    const features = await res.json();

    if (!features.length) {
      grid.innerHTML = '<p class="voting-loading">No features yet — check back soon.</p>';
      return;
    }

    const max = Math.max(1, ...features.map(f => f.votes));
    grid.innerHTML = '';

    for (const f of features) {
      const pct = Math.round((f.votes / max) * 100);
      const voteText = f.votes + ' vote' + (f.votes !== 1 ? 's' : '');

      const card = document.createElement('a');
      card.href = f.url;
      card.target = '_blank';
      card.rel = 'noopener noreferrer';
      card.className = 'voting-card';
      card.innerHTML =
        '<div class="card-top">' +
          '<h3 class="card-title">' + escapeHtml(f.title) + '</h3>' +
        '</div>' +
        '<p class="card-desc">' + escapeHtml(f.desc) + '</p>' +
        '<div class="card-footer">' +
          '<div class="vote-bar-wrap">' +
            '<div class="vote-bar" style="width: ' + pct + '%"></div>' +
          '</div>' +
          '<span class="vote-count">' + voteText + '</span>' +
        '</div>';
      grid.appendChild(card);
    }
  } catch (_) {
    // silently fail — votes are non-critical
  }
}

loadVotes();
</script>

<style is:global>
.voting-section {
  margin: 2rem 0;
}
.voting-subtitle {
  color: var(--sl-color-text-accent);
  margin-bottom: 1.5rem;
  font-size: 0.95rem;
}
.voting-loading {
  color: var(--sl-color-text);
  opacity: 0.5;
  font-size: 0.9rem;
}
.voting-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1rem;
  margin-bottom: 1rem;
}
.voting-card {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  padding: 1.2rem;
  border: 1px solid var(--sl-color-hairline);
  border-radius: 0.75rem;
  background: var(--sl-color-bg-inline-code);
  text-decoration: none;
  color: inherit;
  transition: border-color 0.2s, transform 0.2s;
}
.voting-card:hover {
  border-color: var(--sl-color-accent);
  transform: translateY(-2px);
}
.card-top {
  display: flex;
  align-items: center;
  gap: 0.6rem;
}
.card-title {
  font-size: 0.95rem;
  font-weight: 600;
  margin: 0;
  color: var(--sl-color-white);
}
.card-desc {
  font-size: 0.8rem;
  color: var(--sl-color-text);
  flex: 1;
  margin: 0;
}
.card-footer {
  display: flex;
  align-items: center;
  gap: 0.6rem;
}
.vote-bar-wrap {
  flex: 1;
  height: 4px;
  background: var(--sl-color-hairline);
  border-radius: 2px;
  overflow: hidden;
}
.vote-bar {
  height: 100%;
  background: var(--sl-color-accent);
  border-radius: 2px;
  transition: width 0.6s ease;
}
.vote-count {
  font-size: 0.75rem;
  color: var(--sl-color-text-accent);
  white-space: nowrap;
  min-width: 4rem;
  text-align: right;
}
.voting-note {
  font-size: 0.75rem;
  color: var(--sl-color-text);
  opacity: 0.5;
  text-align: center;
  margin-top: 0.5rem;
}
</style>
